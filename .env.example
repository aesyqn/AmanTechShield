# Example environment configuration for AmanTech
# Copy this file to `.env` in the project root and fill in real values.

# Shared or personal Supabase Postgres connection string
# The owner can share one DATABASE_URL with teammates,
# or each developer can create their own Supabase project.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.xxx.supabase.co:5432/postgres"

# Backend HTTP port
BACKEND_PORT=4000
